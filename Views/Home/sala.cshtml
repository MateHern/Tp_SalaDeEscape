@using LaMejorSala.Models

@{
    ViewData["Title"] = "Sala";

    Sala sala = ViewBag.Sala;
    Acertijo acertijo = ViewBag.Acertijo;

   int errores = ViewBag.Errores ?? 0;
    string peligro = ViewBag.Peligro ?? "NIVEL 1";
        string mensajePeligro = ViewBag.MensajePeligro ?? "No escuchás nada. El estadio parece vacío.";
}

<div class="sala sala-@sala.Numero">

    <div class="sala-contenido">

        <div class="sala-arriba">
            <span>SALA @sala.Numero DE 5</span>
        </div>

        <h1>@sala.Nombre</h1>

        <p class="descripcion-sala">
            @sala.Descripcion
        </p>

        @if (sala.Numero == 1)
        {
            <div class="sala1-simon">

                <div class="simon-header">
                    <h2>EL VESTUARIO ABANDONADO</h2>
                    <p>REPETÍ LA SECUENCIA</p>
                </div>

                <div id="mensaje-sala1" class="mensaje-simon">MEMORIZÁ LA SECUENCIA</div>

                <div class="tablero-simon">
                    <button type="button" class="jugador-btn" data-index="0" data-imagen="~/img/battaglia.jpg">
                        <img src="~/img/battaglia.jpg" alt="SEBASTIÁN BATTAGLIA" />
                        <span class="jugador-nombre">SEBASTIÁN BATTAGLIA</span>
                    </button>

                    <button type="button" class="jugador-btn" data-index="1" data-imagen="~/img/roncaglia.jpg">
                        <img src="~/img/roncaglia.jpg" alt="FACUNDO RONCAGLIA" />
                        <span class="jugador-nombre">FACUNDO RONCAGLIA</span>
                    </button>

                    <button type="button" class="jugador-btn" data-index="2" data-imagen="~/img/centurion.jpg">
                        <img src="~/img/centurion.jpg" alt="RICARDO CENTURIÓN" />
                        <span class="jugador-nombre">RICARDO CENTURIÓN</span>
                    </button>

                    <button type="button" class="jugador-btn" data-index="3" data-imagen="~/img/gimenez.jpg">
                        <img src="~/img/gimenez.jpg" alt="MILTON GIMÉNEZ" />
                        <span class="jugador-nombre">MILTON GIMÉNEZ</span>
                    </button>

                    <button type="button" class="jugador-btn" data-index="4" data-imagen="~/img/rojo.jpg">
                        <img src="~/img/rojo.jpg" alt="MARCOS ROJO" />
                        <span class="jugador-nombre">MARCOS ROJO</span>
                    </button>

                    <button type="button" class="jugador-btn" data-index="5" data-imagen="~/img/briasco.jpg">
                        <img src="~/img/briasco.jpg" alt="NORBERTO BRIASCO" />
                        <span class="jugador-nombre">NORBERTO BRIASCO</span>
                    </button>
                </div>

                <div class="acciones-simon">
                    <button type="button" id="iniciar-sala1" class="boton">COMENZAR</button>
                </div>

                <div id="sala1-finished" class="sala1-finished oculto">
                    <p class="titulo-final-sala1">SECUENCIA COMPLETADA</p>
                    <p>Encontraste la combinación del vestuario.</p>
                    <button type="button" id="abrir-puerta-sala1" class="boton">ABRIR LA PUERTA</button>
                </div>
            </div>

            <script>
                const jugadoresSala1 = [
                    "SEBASTIÁN BATTAGLIA",
                    "FACUNDO RONCAGLIA",
                    "RICARDO CENTURIÓN",
                    "MILTON GIMÉNEZ",
                    "MARCOS ROJO",
                    "NORBERTO BRIASCO"
                ];

                let secuenciaSala1 = [];
                let indiceUsuarioSala1 = 0;
                let nivelSala1 = 1;
                let reproduciendoSala1 = false;

                const mensajeSala1 = document.getElementById('mensaje-sala1');
                const botonesSala1 = document.querySelectorAll('.jugador-btn');

                botonesSala1.forEach((boton) => {
                    const img = boton.querySelector('img');
                    const nombre = boton.querySelector('.jugador-nombre');

                    if (img && nombre) {
                        img.onerror = function () {
                            img.style.display = 'none';
                            nombre.style.display = 'block';
                        };
                    }
                });

                const botonIniciarSala1 = document.getElementById('iniciar-sala1');
                const botonAbrirPuertaSala1 = document.getElementById('abrir-puerta-sala1');
                const finalSala1 = document.getElementById('sala1-finished');

                function mostrarMensajeSala1(texto, tipo = 'normal') {
                    mensajeSala1.textContent = texto;
                    mensajeSala1.className = 'mensaje-simon ' + tipo;
                }

                function iluminarBotonSala1(index) {
                    const boton = botonesSala1[index];
                    if (!boton) return;

                    boton.classList.add('activo');
                    setTimeout(() => boton.classList.remove('activo'), 450);
                }

                function generarSecuenciaSala1() {
                    secuenciaSala1 = [];
                    const longitud = nivelSala1 + 1;

                    for (let i = 0; i < longitud; i++) {
                        secuenciaSala1.push(Math.floor(Math.random() * jugadoresSala1.length));
                    }

                    indiceUsuarioSala1 = 0;
                    reproducirSecuenciaSala1();
                }

                function reproducirSecuenciaSala1() {
                    reproduciendoSala1 = true;
                    mostrarMensajeSala1('MEMORIZÁ LA SECUENCIA');

                    let paso = 0;
                    const temporizador = setInterval(() => {
                        iluminarBotonSala1(secuenciaSala1[paso]);
                        paso++;

                        if (paso >= secuenciaSala1.length) {
                            clearInterval(temporizador);
                            setTimeout(() => {
                                reproduciendoSala1 = false;
                                mostrarMensajeSala1('REPETÍ LA SECUENCIA');
                            }, 500);
                        }
                    }, 700);
                }

                function iniciarSala1() {
                    finalSala1.classList.add('oculto');
                    botonAbrirPuertaSala1.disabled = true;
                    generarSecuenciaSala1();
                }

                function registrarErrorSala1() {
                    reproduciendoSala1 = true;
                    mostrarMensajeSala1('SECUENCIA INCORRECTA', 'error');

                    fetch('/Home/RegistrarErrorSala1', {
                        method: 'POST'
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.peligroMaximo) {
                            window.location.href = data.redirect;
                            return;
                        }

                        setTimeout(() => {
                            reproduciendoSala1 = false;
                            generarSecuenciaSala1();
                        }, 1000);
                    })
                    .catch(() => {
                        setTimeout(() => {
                            reproduciendoSala1 = false;
                            generarSecuenciaSala1();
                        }, 1000);
                    });
                }

                function completarSala1() {
                    fetch('/Home/CompletarSala1', {
                        method: 'POST'
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.ok && data.redirect) {
                            window.location.href = data.redirect;
                        }
                    });
                }

                botonesSala1.forEach((boton, index) => {
                    boton.addEventListener('click', () => {
                        if (reproduciendoSala1) {
                            return;
                        }

                        boton.classList.add('presionado');
                        setTimeout(() => boton.classList.remove('presionado'), 180);

                        const valorEsperado = secuenciaSala1[indiceUsuarioSala1];

                        if (index === valorEsperado) {
                            indiceUsuarioSala1++;

                            if (indiceUsuarioSala1 === secuenciaSala1.length) {
                                if (nivelSala1 >= 5) {
                                    reproduciendoSala1 = true;
                                    mostrarMensajeSala1('SECUENCIA COMPLETADA', 'ok');
                                    finalSala1.classList.remove('oculto');
                                    botonAbrirPuertaSala1.disabled = false;
                                    return;
                                }

                                nivelSala1++;
                                mostrarMensajeSala1('NIVEL ' + nivelSala1 + ' - ¡BUENA SECUENCIA!', 'ok');

                                setTimeout(() => {
                                    generarSecuenciaSala1();
                                }, 1000);
                            }
                        } else {
                            registrarErrorSala1();
                        }
                    });
                });

                botonIniciarSala1.addEventListener('click', iniciarSala1);
                botonAbrirPuertaSala1.addEventListener('click', completarSala1);

                window.addEventListener('DOMContentLoaded', iniciarSala1);
            </script>
        }
        else if (sala.Numero == 2)
        {
            int situacion = ViewBag.Situacion is int ? (int)ViewBag.Situacion : 1;

            <div class="prueba-puertas">

                <h2>EL TÚNEL OSCURO</h2>

                <p>
                    Mirá cuidadosamente la imagen.
                    Hay una pista escondida que te indica qué puerta elegir.
                </p>

                @if (situacion == 1)
                {
                    <img src="~/img/puerta1.jpg" class="imagen-puerta" alt="Túnel oscuro">
                }

                @if (situacion == 2)
                {
                    <img src="~/img/puerta2.jfif" class="imagen-puerta" alt="Túnel oscuro">
                }

                @if (situacion == 3)
                {
                    <img src="~/img/puerta3.jfif" class="imagen-puerta" alt="Túnel oscuro">
                }

                <div class="botones-puerta">

                    <form method="post" action="/Home/ElegirPuerta">
                        <input type="hidden" name="puerta" value="1">
                        <button type="submit">PUERTA 1</button>
                    </form>

                    <form method="post" action="/Home/ElegirPuerta">
                        <input type="hidden" name="puerta" value="2">
                        <button type="submit">PUERTA 2</button>
                    </form>

                </div>

            </div>
        }
        else
        {
            @if (sala.Numero == 4)
            {
                <div class="prueba-imagenes">

                    @if (acertijo.Numero == 1)
                    {
                        <div class="imagen-acertijo">

                            <p class="numero-acertijo">
                                DESAFÍO 1 DE 4
                            </p>

                            <img src="~/img/numero1.jfif"
                                 alt="Imagen con un número escondido" />

                            <h2>ENCONTRÁ EL NÚMERO</h2>

                            <p>
                                Hay un número escondido en la imagen.
                                Mirá atentamente y encontralo.
                            </p>

                        </div>
                    }

                    @if (acertijo.Numero == 2)
                    {
                        <div class="imagen-acertijo">

                            <p class="numero-acertijo">
                                DESAFÍO 2 DE 4
                            </p>

                            <img src="~/img/numero2.jfif"
                                 alt="Imagen con un número escondido" />

                            <h2>ENCONTRÁ EL NÚMERO</h2>

                            <p>
                                Buscá atentamente el número escondido.
                            </p>

                        </div>
                    }

                    @if (acertijo.Numero == 3)
                    {
                        <div class="imagen-acertijo">

                            <p class="numero-acertijo">
                                DESAFÍO 3 DE 4
                            </p>

                            <img src="~/img/numero3.jfif"
                                 alt="Imagen con un número escondido" />

                            <h2>ENCONTRÁ EL NÚMERO</h2>

                            <p>
                                Buscá el último número escondido.
                            </p>

                        </div>
                    }

                    @if (acertijo.Numero == 4)
                    {
                        <div class="codigo-final">

                            <p class="numero-acertijo">
                                DESAFÍO FINAL
                            </p>

                            <h2>EL ÚLTIMO MENSAJE DE RIQUELME</h2>

                            <p>
                                Encontraste los seis números. Ahora tenés que formar el código final.
                            </p>

                            <div class="mensaje-riquelme">

                                <p>
                                    "El amarillo va primero."
                                </p>

                                <p>
                                    "El rojo va segundo."
                                </p>

                                <p>
                                    "El azul va último."
                                </p>

                            </div>

                            <div class="imagenes-codigo-final">
                                <div class="imagen-final-codigo">
                                    <img src="~/img/numero4.jfif" alt="Imagen 4 del museo" />
                                </div>

                                <div class="imagen-final-codigo">
                                    <img src="~/img/numero5.jfif" alt="Imagen 5 del museo" />
                                </div>

                                <div class="imagen-final-codigo">
                                    <img src="~/img/numero6.jfif" alt="Imagen 6 del museo" />
                                </div>
                            </div>

                            <h2>¿CUÁL ES EL CÓDIGO?</h2>

                            <p>
                                Juntá los seis números siguiendo el orden de las imágenes
                                y el cierre de la secuencia final.
                            </p>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="acertijo">

                    <p class="numero-acertijo">
                        ACERTIJO @acertijo.Numero DE 4
                    </p>

                    <h2>
                        @acertijo.Pregunta
                    </h2>

                </div>
            }

            <form asp-controller="Home"
                  asp-action="Responder"
                  method="post">

                <input type="hidden"
                       name="idAcertijo"
                       value="@acertijo.Id" />

                <input type="text"
                       name="respuesta"
                       placeholder="Escribí tu respuesta"
                       autocomplete="off" />

                <button type="submit" class="boton">
                    COMPROBAR
                </button>

            </form>

            <a asp-controller="Home"
               asp-action="Pista"
               asp-route-idAcertijo="@acertijo.Id"
               class="boton-pista">
                👁️ PEDIR PISTA
            </a>
        }

        @if (TempData["Error"] != null)
        {
            <div class="mensaje-error">
                ⚠️ @TempData["Error"]
            </div>
        }

        @if (TempData["Correcto"] != null)
        {
            <div class="mensaje-correcto">
                ✓ @TempData["Correcto"]
            </div>
        }

        @if (TempData["Pista"] != null)
        {
            <div class="pista">

                <h3>📻 MENSAJE DE RIQUELME</h3>

                <p>
                    @TempData["Pista"]
                </p>

            </div>
        }

    </div>

    <div class="peligro">

        <div class="peligro-titulo">
            👁️ PRESENCIA EN LA BOMBONERA
        </div>

        <div class="peligro-nivel">
            NIVEL DE PELIGRO:
            <strong>@peligro</strong>
        </div>

        <div class="barra-peligro">

            <div class="barra-peligro-progreso"
                 style="width:@(errores * 20)%">
            </div>

        </div>

        <p>
            @mensajePeligro
        </p>

    </div>

</div>

