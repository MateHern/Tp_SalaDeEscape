@{
    ViewData["Title"] = "Escape de la Bombonera";
}

<div class="inicio">

    <div class="inicio-contenido">

        <p class="texto-pequeno">
            LA MEJOR SALA PRESENTA
        </p>

        <h1>
            ESCAPE DE<br />
            LA BOMBONERA
        </h1>

        <p class="subtitulo">
            Una noche. Cinco salas. Veinte acertijos.
            Y alguien que no quiere que salgas.
        </p>

        <div class="botones-inicio">

            <a asp-controller="Home"
               asp-action="Identificacion"
               class="boton">
                COMENZAR
            </a>

            <a asp-controller="Home"
               asp-action="Tutorial"
               class="boton-secundario">
                ¿CÓMO SE JUEGA?
            </a>

            <a asp-controller="Home"
               asp-action="Integrantes"
               class="boton-secundario">
                INTEGRANTES
            </a>

        </div>

    </div>

</div>