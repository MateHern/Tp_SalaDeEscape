@{
    long? tiempoInicioPartida = null;
    var tiempoInicioRaw = Context.Session.GetString("TiempoInicioPartida");

    if (!string.IsNullOrWhiteSpace(tiempoInicioRaw) && long.TryParse(tiempoInicioRaw, out long tiempoInicio))
    {
        tiempoInicioPartida = tiempoInicio;
    }

    var tiempoFinPartida = tiempoInicioPartida.HasValue
        ? tiempoInicioPartida.Value + (30 * 60 * 1000)
        : 0L;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LaMejorSala</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LaMejorSala.styles.css" asp-append-version="true" />
</head>
<body data-timer-end="@tiempoFinPartida">
    <header>
        <nav class="header">
            <a asp-controller="Home"
               asp-action="Index"
               class="volver-inicio">
                VOLVER AL INICIO
            </a>
        </nav>
    </header>

    @if (Context.Session.GetInt32("PartidaId") != null)
    {
        <div class="contador-global">
            <span class="contador-label">TIEMPO RESTANTE</span>
            <span class="contador-valor" data-timer="countdown">30:00</span>
        </div>
    }

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
